{
  "expo": {
    "name": "Sonary",
    "slug": "sonary-pro",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "com.sonarypro.app",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonarypro.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.sonarypro.app",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "extraMavenRepos": [
              "https://www.jitpack.io"
            ]
          }
        }
      ],
      "./plugins/withTrackPlayerFGS",
      "./plugins/withAndroidStartupFix",
      "./plugins/withBackgroundDownloads",
      "./plugins/withReleaseSigning",
      "./plugins/withAppUpdater",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite selecionar fotos da sua galeria para personalizar capas de playlists."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
